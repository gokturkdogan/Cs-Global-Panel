{
  "name": "cs-global-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "audit": "pnpm audit --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:verify": "node scripts/db/verify.ts",
    "db:init": "node scripts/db/init.ts",
    "db:migrate": "node scripts/db/migrate.ts",
    "db:seed": "node scripts/db/seed.ts",
    "db:studio": "node scripts/db/studio.ts",
    "auth:bootstrap": "node scripts/auth/bootstrap.ts",
    "auth:reset-password": "node scripts/auth/reset-password.ts"
  },
  "dependencies": {
    "better-auth": "1.7.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "geist": "1.9.2",
    "get-nonce": "1.0.1",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
